# Copy to data-raw/slurm/cluster.env (gitignored) and fill in. Read by submit.sh;
# exported to every array job (array.sh). Adapted from the iHEA_2027 script at tag
# freeze-ihea2027-abstract-v3 (slurm/cluster.env.example). JHPCE defaults
# (https://jhpce.jhu.edu/slurm/partitions/, https://jhpce.jhu.edu/storage/fastscratch).
PARTITION=shared
# Not needed on JHPCE: leave empty and submit.sh omits --account
ACCOUNT=
R_MODULE=conda_R/4.5
# The shared QOS normally allows about 100 cores per user
MAX_PARALLEL=100
# The clone of the package repo on the cluster (branch pkg-train; chmod -R go-rwx)
PROJECT_DIR=$HOME/research/promis2eq5d
# Results on fastscratch (1 TB per user; files older than 30 days are purged,
# no backup: copy $OUT/fits and $OUT/selected.csv off after the run)
OUT=/fastscratch/myscratch/$USER/p2e_train
# The licensed T-score table: a path in your own account, outside the repo,
# chmod go-rwx. Never commit it.
# PROJECT_DIR, OUT and TSCORE_TABLE must not contain commas or spaces (sbatch --export is
# comma-delimited).
TSCORE_TABLE=

# Per-stage limits. TIME = 3 x the longest projected full-size unit of the stage
# (data-raw/train/README.md time table); one array has one --time, so the stage's
# slowest unit sets it.
#  cv:      longest unit about 5 min (D03 variant; R09 config about 3 min) -> 3 x 5 min = 15 min;
#           raised to 30 min because the projection ignores Q (5 -> 50) for R09
#  select:  seconds -> 10 min
#  bundle:  the R06 bundles drive this: 7.1 h (S1) -> 3 x 7.1 h = 21.3 h; raised to 48 h
#           because the projection ignores Q (5 -> 50). Check the shared partition maximum
#           walltime with: sinfo -o "%P %l" , and lower TIME_BUNDLE if it is shorter. All other bundles take 4-15 min
#           but share the same array --time.
#  collect: reads the 23 bundle files -> 10 min
#  core, boot, merge: the chunked bundles (R06_mvop_dim, D03_clad; data-raw/train/README.md).
#           core = point + K fold fits (+ the R06 out-of-fold simulation); boot = one chunk of
#           bootstrap attempts; merge = the few replacement attempts + writing the bundle.
#           Placeholders: set TIME_BOOT and the chunk sizes from the measured core times.
# Memory was NOT measured: these are conservative guesses. Check sacct MaxRSS after the
# first stage and tighten them.
TIME_CV=00:30:00
MEM_CV=8G
TIME_SELECT=00:10:00
MEM_SELECT=4G
TIME_BUNDLE=48:00:00
MEM_BUNDLE=8G
TIME_COLLECT=00:10:00
MEM_COLLECT=4G
TIME_CORE=12:00:00
MEM_CORE=4G
TIME_BOOT=06:00:00
MEM_BOOT=4G
TIME_MERGE=01:00:00
MEM_MERGE=4G
# Bootstrap attempts per boot chunk (list.sh boot); empty = the driver's defaults
# (R06 20, D03 25). The last chunk of a bundle may be shorter.
BOOT_CHUNK_R06=
BOOT_CHUNK_D03=
